<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Konberter</title>
    <link rel="stylesheet" href="./css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css">
</head>
<body class="bg-sky-600 flex justify-center items-center min-h-screen px-4">
    <div class="bg-white w-full max-w-[600px] rounded-md h-3/4 py-5 px-5">
        <h1 class="text-center text-sky-600 font-bold text-3xl lg:text-4xl mb-8">KONBERTER</h1>

        <form action="" method="post">
            <div class="flex flex-col gap-1 text-md lg:text-lg mb-5">
                <label for="money">Enter Amount:</label>
                <input type="number" min="0" step="0.01" id="money" name="money" required class="border border-gray-400 outline-none rounded-xs p-1 focus:ring-3 focus:ring-sky-300 focus:border-sky-600 transition duration-100">
            </div>

            <div class="text-md lg:text-lg flex items-center justify-between gap-3 mb-5">
                <div class="grow">
                    <label for="base-currency" class="block">From</label>
                    <select name="base-currency" id="base-currency" required class="border border-gray-400 outline-none rounded-xs p-1 focus:ring-3 focus:ring-sky-300 focus:border-sky-600 transition duration-100 w-full">
                        <option value="">PHP</option>
                        <option value="">USD</option>
                        <option value="">TWD</option>
                    </select>
                </div>

                <div>
                    <i class="bi bi-arrow-right text-6xl"></i>
                </div>

                <div class="grow">
                    <label for="target-currency" class="block">To</label>
                    <select name="target-currency" id="target-currency" required class="border border-gray-400 outline-none rounded-xs p-1 focus:ring-3 focus:ring-sky-300 focus:border-sky-600 transition duration-100 w-full">
                        <option value="">PHP</option>
                        <option value="">USD</option>
                        <option value="">TWD</option>
                    </select>
                </div>
            </div>

            <p class="text-gray-500 text-md lg:text-xl mb-5">1 USD = 50 PHP</p>

            <button type="Submit" class="w-full bg-sky-600 text-white font-semibold rounded-sm text-md mb-5 lg:text-xl p-1.5 hover:bg-sky-500 transition duration-100 hover:cursor-pointer">Convert</button>
        </form>

        <p class="text-center text-sm font-semibold">Made with 🩵 by <a href="https://github.com/DiotheWind" target="_blank" class="text-sky-600 hover:underline">Deo Seth Jabagat</a></p>
    </div>
</body>
</html>
